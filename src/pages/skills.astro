---
import { ArrowUpRight, Mail } from 'lucide-react'
import BaseLayout from '#/layouts/BaseLayout.astro'
import StackGroups from '#/components/site/StackGroups.astro'
import { principles, site } from '#/data/site'
import { skillGroups } from '#/data/skills'

const total = skillGroups.reduce(
  (count, group) => count + group.items.length,
  0,
)
---

<BaseLayout
  title={`Skills — ${site.name}`}
  description="The languages, frameworks, and tools I reach for most."
>
  <main id="main" class="page-shell pb-20 pt-14 sm:pt-20">
    <div class="grid gap-8 border-b border-border pb-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="label">Skills</p>
        <h1 class="mt-4 max-w-2xl text-[clamp(1.8rem,4vw,3rem)] leading-tight">
          What I work with<span class="text-muted-foreground">.</span>
        </h1>
        <p class="measure mt-5 text-sm leading-7 text-muted-foreground">
          The languages, frameworks, and tools I reach for most, grouped by what
          they do. No ratings — just the things I actually use.
        </p>
      </div>

      <p class="text-xs text-muted-foreground lg:col-span-3 lg:col-start-10 lg:self-end">
        {total} tools in {skillGroups.length} groups
      </p>
    </div>

    <div class="grid gap-12 pt-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <StackGroups columns={2} />
      </div>

      <aside class="space-y-10 lg:col-span-3 lg:col-start-10">
        <section>
          <h2 class="label">How I work</h2>
          <ol class="mt-4">
            {principles.map((principle, index) => (
              <li class="flex gap-3 border-b border-border py-3 text-sm leading-6">
                <span class="text-xs text-muted-foreground">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span>{principle}</span>
              </li>
            ))}
          </ol>
        </section>

        <section class="border-t border-border pt-6">
          <h2 class="label">Find me</h2>
          <div class="mt-4 space-y-3 text-sm">
            <a
              href={site.github}
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline flex w-fit"
            >
              GitHub
              <ArrowUpRight className="size-3.5" aria-hidden="true" />
            </a>
            <a href={`mailto:${site.email}`} class="link-underline flex w-fit">
              <Mail className="size-3.5" aria-hidden="true" />
              Email
            </a>
          </div>
        </section>

        <p class="text-xs leading-6 text-muted-foreground">
          {site.availability}
        </p>
      </aside>
    </div>
  </main>
</BaseLayout>
