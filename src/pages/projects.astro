---
import BaseLayout from '#/layouts/BaseLayout.astro'
import { ProjectExplorer } from '#/components/ProjectExplorer'
import { projects } from '#/data/projects'
import { site } from '#/data/site'

const total = projects.length
---

<BaseLayout
  title={`Work — ${site.name}`}
  description="A few things I have built: study tools, a manga reader, a timer, and a time logger."
>
  <main id="main" class="page-shell pb-20 pt-14 sm:pt-20">
    <div class="grid gap-8 border-b border-border pb-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="label">Work</p>
        <h1 class="mt-4 text-[clamp(1.8rem,4vw,3rem)] leading-tight">
          Work<span class="text-muted-foreground">.</span>
        </h1>
        <p class="measure mt-5 text-sm leading-7 text-muted-foreground">
          A few things I've built. Most of them started as a problem I had, then
          grew into something I could share.
        </p>
      </div>

      <p class="text-xs text-muted-foreground lg:col-span-3 lg:col-start-10 lg:self-end">
        {total} project{total === 1 ? '' : 's'}
      </p>
    </div>

    <ProjectExplorer client:load projects={projects} />
  </main>
</BaseLayout>
