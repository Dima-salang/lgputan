---
import { Mail, ArrowUpRight } from 'lucide-react'
import BaseLayout from '#/layouts/BaseLayout.astro'
import ArchiveRow from '#/components/site/ArchiveRow.astro'
import { site } from '#/data/site'
import { getPublishedPosts } from '#/lib/content'
import { groupByYear } from '#/lib/data'

const posts = await getPublishedPosts()
const groups = groupByYear(posts)
---

<BaseLayout
  title={`Writing — ${site.name}`}
  description="Notes on what I'm learning, building, and getting wrong."
>
  <main id="main" class="page-shell pb-20 pt-14 sm:pt-20">
    <div class="grid gap-8 border-b border-border pb-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="label">Writing</p>
        <h1 class="mt-4 text-[clamp(1.8rem,4vw,3rem)] leading-tight">
          Writing<span class="text-muted-foreground">.</span>
        </h1>
        <p class="measure mt-5 text-sm leading-7 text-muted-foreground">
          Notes on what I'm learning, building, and getting wrong. Long enough
          to be useful, short enough to finish.
        </p>
      </div>

      <p class="text-xs text-muted-foreground lg:col-span-3 lg:col-start-10 lg:self-end">
        {posts.length} published
      </p>
    </div>

    {posts.length > 0 ? (
      <div class="mt-8 space-y-8">
        {groups.map((group) => (
          <section>
            <h2 class="mb-2 text-xs text-muted-foreground">{group.year}</h2>
            <div>
              {group.items.map((post) => (
                <ArchiveRow post={post} />
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="measure mt-10 border-t border-border pt-8">
        <p class="text-sm text-foreground">Nothing published yet.</p>
        <p class="mt-2 text-sm leading-7 text-muted-foreground">
          I'm working on the first post. In the meantime, you can email me or
          look through the projects.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
          <a href={`mailto:${site.email}`} class="link-underline">
            <Mail className="size-3.5" aria-hidden="true" />
            Email me
          </a>
          <a href="/projects" class="link-underline">
            See the work
            <ArrowUpRight className="size-3.5" aria-hidden="true" />
          </a>
        </div>
      </div>
    )}
  </main>
</BaseLayout>
