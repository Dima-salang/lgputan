---
import { ArrowLeft, Mail } from 'lucide-react'
import BaseLayout from '#/layouts/BaseLayout.astro'
import { site } from '#/data/site'
---

<BaseLayout
  title={`Page not found — ${site.name}`}
  description="That page does not exist."
>
  <main id="main" class="page-shell pb-20 pt-20 sm:pt-28">
    <p class="label">404 / Not found</p>

    <h1 class="mt-4 text-[clamp(1.9rem,4.2vw,3.2rem)] leading-tight">
      Nothing here<span class="text-muted-foreground">.</span>
    </h1>

    <p class="measure mt-5 text-sm leading-7 text-muted-foreground">
      The page may have moved, or the link may be wrong. The work and writing
      pages are still where you left them.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
      <a href="/" class="link-underline">
        <ArrowLeft className="size-3.5" aria-hidden="true" />
        Back home
      </a>
      <a href={`mailto:${site.email}`} class="link-underline">
        <Mail className="size-3.5" aria-hidden="true" />
        Email me
      </a>
    </div>
  </main>
</BaseLayout>
