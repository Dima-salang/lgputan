---
import { ArrowUpRight, Mail } from 'lucide-react'
import BaseLayout from '#/layouts/BaseLayout.astro'
import { LocalTime } from '#/components/site/LocalTime'
import { bio, principles, site } from '#/data/site'
---

<BaseLayout
  title={`About — ${site.name}`}
  description={`${site.shortRole} from ${site.location}.`}
>
  <main id="main" class="page-shell pb-20 pt-14 sm:pt-20">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-8">
        <p class="label">About</p>
        <h1 class="mt-4 text-[clamp(1.9rem,4.2vw,3.2rem)] leading-tight">
          Luis Gabrielle <span class="italic text-muted-foreground">Putan</span>
          .
        </h1>

        <div class="measure mt-8 space-y-5">
          {bio.map((paragraph, index) => (
            <p
              class={
                index === 0
                  ? 'text-sm leading-7 text-foreground'
                  : 'text-sm leading-7 text-muted-foreground'
              }
            >
              {paragraph}
            </p>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
          <a href={`mailto:${site.email}`} class="link-underline">
            <Mail className="size-3.5" aria-hidden="true" />
            Email
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline"
          >
            GitHub
            <ArrowUpRight className="size-3.5" aria-hidden="true" />
          </a>
          <a href="/projects" class="link-underline">
            Work
            <ArrowUpRight className="size-3.5" aria-hidden="true" />
          </a>
        </div>
      </div>

      <aside class="lg:col-span-3 lg:col-start-10">
        <dl class="border-t border-border text-xs">
          <div class="flex items-baseline justify-between gap-4 border-b border-border py-2.5">
            <dt class="text-muted-foreground">Based in</dt>
            <dd>{site.location}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-b border-border py-2.5">
            <dt class="text-muted-foreground">Local time</dt>
            <dd>
              <LocalTime client:idle />
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-b border-border py-2.5">
            <dt class="text-muted-foreground">Status</dt>
            <dd>{site.availability}</dd>
          </div>
        </dl>
      </aside>
    </div>

    <section class="mt-16 grid gap-8 border-t border-border pt-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-3">
        <h2 class="label">How I work</h2>
      </div>

      <ol class="lg:col-span-8 lg:col-start-5">
        {principles.map((principle, index) => (
          <li class="grid grid-cols-[2rem_1fr] gap-4 border-b border-border py-4 first:border-t">
            <span class="text-xs text-muted-foreground">
              {String(index + 1).padStart(2, '0')}
            </span>
            <p class="text-base leading-7">{principle}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-16 grid gap-8 border-t border-border pt-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-3">
        <h2 class="label">Now</h2>
      </div>

      <div class="lg:col-span-8 lg:col-start-5">
        <p class="measure text-sm leading-7 text-muted-foreground">
          Building Excelsior Academy. Studying Computer Science. Based in the
          Philippines.
        </p>
      </div>
    </section>

    <section class="mt-16 border-t border-border pt-12">
      <h2 class="text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.2]">
        Say hello<span class="text-muted-foreground">.</span>
      </h2>
      <div class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="max-w-md text-sm leading-7 text-muted-foreground">
            {site.availability}. I'm happy to talk about roles, projects, or
            anything you're building.
          </p>
          <p class="mt-2 text-xs text-muted-foreground">{site.location}</p>
        </div>
        <a
          href={`mailto:${site.email}`}
          class="link-underline break-all text-sm"
        >
          <Mail className="size-3.5" aria-hidden="true" />
          {site.email}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
