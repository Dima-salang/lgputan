---
import { ArrowUpRight, GithubIcon, Mail } from 'lucide-react'
import BaseLayout from '#/layouts/BaseLayout.astro'
import { Dither } from '#/components/site/Dither'
import { LocalTime } from '#/components/site/LocalTime'
import { bio, now, principles, site } from '#/data/site'

const year = new Date().getFullYear()
---

<BaseLayout
  title={`About — ${site.name}`}
  description={`${site.shortRole} from ${site.location}.`}
>
  <main id="main" class="page-shell py-14 sm:py-20">
    <div class="border-b border-border pb-10">
      <p class="section-label">
        <span class="index">04</span>
        <span class="text-muted-foreground/50" aria-hidden="true">
          /
        </span>
        <span>About</span>
      </p>
    </div>

    <div class="mt-10 grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-8">
        <h1 class="font-display text-[clamp(3.2rem,8vw,6rem)] leading-[0.88] tracking-[-0.035em]">
          {site.displayFirst}
          <br />
          <span class="italic">{site.displayLast}</span>
          <span class="text-acid">.</span>
        </h1>

        <div class="mt-10 max-w-2xl space-y-6">
          {bio.map((paragraph, index) => (
            <p
              class={
                index === 0
                  ? 'text-lg leading-relaxed text-foreground sm:text-xl'
                  : 'text-base leading-relaxed text-muted-foreground'
              }
            >
              {paragraph}
            </p>
          ))}
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-6">
          <a
            href={`mailto:${site.email}`}
            class="link-underline text-[10px] uppercase tracking-[0.12em]"
          >
            <Mail className="size-3.5" aria-hidden="true" />
            Email me
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline text-[10px] uppercase tracking-[0.12em]"
          >
            <GithubIcon className="size-3.5" aria-hidden="true" />
            {site.githubHandle}
          </a>
          <a
            href="/projects"
            class="link-underline text-[10px] uppercase tracking-[0.12em]"
          >
            See the work
            <ArrowUpRight className="size-3.5" aria-hidden="true" />
          </a>
        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="panel p-6">
          <div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.14em] text-muted-foreground">
            <span>Profile</span>
            <span>{year}</span>
          </div>

          <div class="my-10 flex items-end justify-between gap-4">
            <span class="font-display text-[5.5rem] leading-[0.75]">
              LP<span class="text-acid">.</span>
            </span>
            <Dither seed={site.name} rows={4} columns={6} />
          </div>

          <dl class="border-t border-border">
            {now.map((item) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-border py-3">
                <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-muted-foreground">
                  {item.label}
                </dt>
                <dd class="text-right font-mono text-[11px] text-foreground">
                  {item.value}
                </dd>
              </div>
            ))}
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-muted-foreground">
                Local time
              </dt>
              <dd class="font-mono text-[11px] text-foreground">
                <LocalTime client:idle />
              </dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>

    <section class="mt-16 grid gap-8 border-t border-border pt-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="section-label">
          <span>How I work</span>
        </h2>
      </div>

      <ol class="lg:col-span-8">
        {principles.map((principle, index) => (
          <li class="grid grid-cols-[2rem_1fr] gap-4 border-b border-border py-5 first:border-t">
            <span class="pt-1 font-mono text-[10px] text-acid">
              0{index + 1}
            </span>
            <p class="font-display text-2xl leading-snug sm:text-3xl">
              {principle}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-16 border-t border-border pt-12">
      <h2 class="font-display text-[clamp(2.8rem,7vw,5rem)] leading-[0.95] tracking-[-0.03em]">
        Say hello<span class="text-acid">.</span>
      </h2>
      <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="max-w-md text-sm leading-relaxed text-muted-foreground">
            {site.availability}. I'm happy to talk about roles, projects, or
            anything you're building.
          </p>
          <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.12em] text-muted-foreground">
            {site.location}
          </p>
        </div>
        <a
          href={`mailto:${site.email}`}
          class="link-underline break-all text-sm sm:text-base"
        >
          <Mail className="size-4" aria-hidden="true" />
          {site.email}
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
