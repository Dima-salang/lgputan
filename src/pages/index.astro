---
import { ArrowUpRight, Mail } from 'lucide-react'
import BaseLayout from '#/layouts/BaseLayout.astro'
import { LocalTime } from '#/components/site/LocalTime'
import { primaryProjectLink, projects } from '#/data/projects'
import { bio, now, site } from '#/data/site'
import { skillGroups } from '#/data/skills'
import { getPublishedPosts } from '#/lib/content'
import { formatDate } from '#/lib/data'

const posts = await getPublishedPosts()
const featuredPosts = posts.slice(0, 3)
const featuredProjects = projects.slice(0, 4)
const building = now.find((item) => item.label === 'Building')?.value
const buildingProject = projects.find((project) => project.name === building)
const buildingLink = buildingProject
  ? primaryProjectLink(buildingProject)
  : undefined
---

<BaseLayout>
  <main id="main">
    <section class="page-shell pb-14 pt-16 sm:pb-20 sm:pt-24">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <div class="reveal flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xs text-muted-foreground">
            <span class="text-foreground">{site.name}</span>
            <span class="hidden sm:inline" aria-hidden="true">
              /
            </span>
            <span class="block sm:inline">{site.shortRole}</span>
          </div>

          <p
            class="reveal mt-10 max-w-3xl text-[clamp(1.45rem,2.6vw,2.15rem)] leading-[1.45] tracking-[-0.01em]"
            style="animation-delay: 60ms"
          >
            {site.intro}
          </p>

          <p
            class="reveal mt-6 max-w-xl text-sm leading-7 text-muted-foreground"
            style="animation-delay: 120ms"
          >
            Currently building Excelsior Academy and finishing a Computer
            Science degree.
          </p>

          <div
            class="reveal mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm"
            style="animation-delay: 180ms"
          >
            <a href={`mailto:${site.email}`} class="link-underline">
              <Mail className="size-3.5" aria-hidden="true" />
              Email
            </a>
            <a
              href={site.github}
              target="_blank"
              rel="noopener noreferrer"
              class="link-underline"
            >
              GitHub
              <ArrowUpRight className="size-3.5" aria-hidden="true" />
            </a>
            <a href="/projects" class="link-underline">
              Work
              <ArrowUpRight className="size-3.5" aria-hidden="true" />
            </a>
          </div>
        </div>

        <aside
          class="reveal lg:col-span-3 lg:col-start-10 lg:self-end"
          style="animation-delay: 160ms"
        >
          <dl class="border-t border-border text-xs">
            <div class="flex items-baseline justify-between gap-4 border-b border-border py-2.5">
              <dt class="text-muted-foreground">Based in</dt>
              <dd>{site.location}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-border py-2.5">
              <dt class="text-muted-foreground">Local time</dt>
              <dd>
                <LocalTime client:idle />
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-border py-2.5">
              <dt class="text-muted-foreground">Status</dt>
              <dd class="flex items-center gap-2 text-right">
                <span
                  class="inline-block size-1.5 rounded-full bg-foreground"
                  aria-hidden="true"
                ></span>
                {site.availability}
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="border-t border-border">
      <div class="page-shell grid gap-10 py-12 md:grid-cols-3 md:gap-12">
        <section>
          <h2 class="label">Building</h2>
          <div class="mt-4">
            <p class="text-sm">
              {buildingLink ? (
                <a
                  href={buildingLink.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="row-link inline-flex items-baseline gap-1.5"
                >
                  {building}
                  <ArrowUpRight
                    className="size-3.5 text-muted-foreground"
                    aria-hidden="true"
                  />
                </a>
              ) : (
                building
              )}
            </p>
            <p class="mt-1 text-xs leading-6 text-muted-foreground">
              {buildingProject?.description ??
                'A study tool for better lectures and flashcards.'}
            </p>
          </div>
        </section>

        <section>
          <h2 class="label">Projects</h2>
          <ul class="mt-4 space-y-4">
            {featuredProjects.map((project) => {
              const primary = primaryProjectLink(project)
              return (
                <li>
                  <p class="text-sm">
                    {primary ? (
                      <a
                        href={primary.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="row-link inline-flex items-baseline gap-1.5"
                      >
                        {project.name}
                        <ArrowUpRight
                          className="size-3.5 text-muted-foreground"
                          aria-hidden="true"
                        />
                      </a>
                    ) : (
                      project.name
                    )}
                  </p>
                  <p class="mt-0.5 text-xs leading-6 text-muted-foreground">
                    {project.description}
                  </p>
                </li>
              )
            })}
          </ul>
          <a href="/projects" class="link-underline mt-5 text-xs">
            All projects
            <ArrowUpRight className="size-3" aria-hidden="true" />
          </a>
        </section>

        <section>
          <h2 class="label">Writing</h2>
          {featuredPosts.length > 0 ? (
            <ul class="mt-4 space-y-4">
              {featuredPosts.map((post) => (
                <li>
                  <a href={`/blog/${post.slug}`} class="group block">
                    <span class="row-link text-sm">{post.title}</span>
                    <span class="mt-0.5 block text-xs text-muted-foreground">
                      {formatDate(post.date)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 text-sm leading-7 text-muted-foreground">
              No published posts yet.
            </p>
          )}
          <a href="/blog" class="link-underline mt-5 text-xs">
            All writing
            <ArrowUpRight className="size-3" aria-hidden="true" />
          </a>
        </section>
      </div>
    </section>

    <section class="border-t border-border">
      <div class="page-shell grid gap-8 py-12 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-3">
          <h2 class="label">Now</h2>
        </div>

        <div class="lg:col-span-8 lg:col-start-5">
          <p class="max-w-2xl text-sm leading-7 text-muted-foreground"></p>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-muted-foreground">
            {bio[2]}
          </p>
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline mt-4 text-xs"
          >
            {site.githubHandle}
            <ArrowUpRight className="size-3" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <section class="border-t border-border">
      <div class="page-shell grid gap-8 py-12 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-3">
          <h2 class="label">Tools</h2>
        </div>

        <div class="grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:col-span-8 lg:col-start-5">
          {skillGroups.map((group) => (
            <div>
              <h3 class="label">{group.name}</h3>
              <p class="mt-2 text-sm leading-7 text-muted-foreground">
                {group.items.map((skill) => skill.name).join(', ')}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-border">
      <div class="page-shell grid gap-10 py-16 lg:grid-cols-12 lg:py-24">
        <div class="lg:col-span-7">
          <h2 class="text-[clamp(1.75rem,3.4vw,2.75rem)] leading-[1.2]">
            Let's build{' '}
            <span class="italic text-muted-foreground">something.</span>
          </h2>
        </div>

        <div class="lg:col-span-4 lg:col-start-9">
          <p class="text-sm leading-7 text-muted-foreground">
            {site.availability}. I'm happy to talk about roles, projects, or
            anything you're building.
          </p>
          <a
            href={`mailto:${site.email}`}
            class="link-underline mt-5 break-all text-sm"
          >
            <Mail className="size-3.5" aria-hidden="true" />
            {site.email}
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline mt-3 flex w-fit text-sm"
          >
            GitHub
            <ArrowUpRight className="size-3.5" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
