---
import { ArrowUpRight } from 'lucide-react'
import { links } from '#/data/links'
import { pages, site } from '#/data/site'
import { LocalTime } from '#/components/site/LocalTime'

const year = new Date().getFullYear()
---

<footer class="mt-24 border-t border-border">
  <div class="page-shell py-10">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm text-foreground">
          Small tools,{' '}
          <span class="italic text-muted-foreground">carefully made.</span>
        </p>
        <p class="mt-2 max-w-sm text-sm leading-7 text-muted-foreground">
          {site.shortRole}, based in {site.location}.
        </p>
      </div>

      <nav
        class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-muted-foreground"
        aria-label="Footer navigation"
      >
        {pages.map((page) => (
          <a href={page.to} class="transition-colors hover:text-foreground">
            {page.label}
          </a>
        ))}
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-1 transition-colors hover:text-foreground"
        >
          Email
          <ArrowUpRight className="size-3" aria-hidden="true" />
        </a>
        {links.map((link) => (
          <a
            href={link.url}
            target={link.url.startsWith('http') ? '_blank' : undefined}
            rel={
              link.url.startsWith('http') ? 'noopener noreferrer' : undefined
            }
            class="inline-flex items-center gap-1 transition-colors hover:text-foreground"
          >
            {link.name}
            <ArrowUpRight className="size-3" aria-hidden="true" />
          </a>
        ))}
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-border pt-4 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {site.name}
      </p>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span>
          <LocalTime client:idle /> in {site.location}
        </span>
        <span aria-hidden="true">/</span>
        <span>{site.availability}</span>
      </p>
    </div>
  </div>
</footer>
