---
interface Props {
  index: string
  title: string
}

const { index, title } = Astro.props
---

<div class="flex flex-wrap items-end justify-between gap-4 pb-5">
  <h2 class="section-label text-[11px]">
    <span class="index">{index}</span>
    <span class="text-muted-foreground/50" aria-hidden="true">
      /
    </span>
    <span>{title}</span>
  </h2>
  <slot />
</div>
