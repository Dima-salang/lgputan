---
import { ArrowUpRight } from 'lucide-react'
import { formatDate } from '#/lib/data'
import type { PostSummary } from '#/lib/content'

interface Props {
  post: PostSummary
  showExcerpt?: boolean
}

const { post, showExcerpt = true } = Astro.props
const summary = showExcerpt ? post.description : ''
---

<a
  href={`/blog/${post.slug}`}
  class="group grid gap-2 border-t border-border py-5 sm:grid-cols-[6.5rem_1fr_auto] sm:items-baseline sm:gap-6"
>
  <time
    datetime={post.date.toISOString()}
    class="text-xs text-muted-foreground"
  >
    {formatDate(post.date)}
  </time>

  <div class="min-w-0">
    <h3 class="text-base leading-6 text-foreground">
      <span class="row-link">{post.title}</span>
    </h3>
    {summary ? (
      <p class="mt-1 max-w-2xl text-xs leading-6 text-muted-foreground">
        {summary}
      </p>
    ) : null}
  </div>

  <span class="flex items-center gap-2 text-xs text-muted-foreground">
    {post.readingTime}
    <ArrowUpRight
      className="size-3.5 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
      aria-hidden="true"
    />
  </span>
</a>
