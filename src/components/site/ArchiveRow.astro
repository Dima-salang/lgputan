---
import { ArrowUpRight } from 'lucide-react'
import { formatDate } from '#/lib/data'
import type { PostSummary } from '#/lib/content'

interface Props {
  post: PostSummary
  showExcerpt?: boolean
}

const { post, showExcerpt = true } = Astro.props
const summary = showExcerpt ? post.description : ''
---

<a
  href={`/blog/${post.slug}`}
  class="group grid gap-1 border-t border-border py-5 transition-colors hover:bg-card/40 sm:grid-cols-[7rem_1fr_auto] sm:items-baseline sm:gap-6 sm:px-2"
>
  <time
    datetime={post.date.toISOString()}
    class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted-foreground"
  >
    {formatDate(post.date)}
  </time>

  <div class="min-w-0">
    <h3 class="font-display text-2xl leading-tight transition-colors group-hover:text-acid sm:text-3xl">
      {post.title}
    </h3>
    {summary ? (
      <p class="mt-1 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        {summary}
      </p>
    ) : null}
  </div>

  <span class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.1em] text-muted-foreground">
    {post.readingTime}
    <ArrowUpRight
      className="size-3.5 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-acid"
      aria-hidden="true"
    />
  </span>
</a>
