---
import { ArrowUpRight } from 'lucide-react'
import { now, site } from '#/data/site'
import { LocalTime } from './LocalTime'
---

<div class="panel relative overflow-hidden">
  <div class="flex items-center justify-between border-b border-border px-4 py-3">
    <div class="flex items-center gap-1.5" aria-hidden="true">
      <span class="size-2 rounded-full bg-signal/70"></span>
      <span class="size-2 rounded-full bg-acid/60"></span>
      <span class="size-2 rounded-full bg-soft/60"></span>
    </div>
    <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground">
      Now
    </span>
  </div>

  <dl>
    {now.map((item) => (
      <div class="flex items-baseline justify-between gap-4 border-b border-border px-4 py-3.5">
        <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-muted-foreground">
          {item.label}
        </dt>
        <dd class="text-right font-mono text-xs text-foreground">
          {item.value}
        </dd>
      </div>
    ))}

    <div class="flex items-baseline justify-between gap-4 border-b border-border px-4 py-3.5">
      <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-muted-foreground">
        Local time
      </dt>
      <dd class="font-mono text-xs text-foreground">
        <LocalTime client:idle />
      </dd>
    </div>

    <div class="flex items-baseline justify-between gap-4 px-4 py-3.5">
      <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-muted-foreground">
        GitHub
      </dt>
      <dd>
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-mono text-xs text-foreground transition-colors hover:text-acid"
        >
          {site.githubHandle}
          <ArrowUpRight className="size-3" aria-hidden="true" />
        </a>
      </dd>
    </div>
  </dl>

  <div class="flex items-center justify-between border-t border-border px-4 py-3">
    <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-muted-foreground">
      GMT+8
    </span>
    <span class="animate-blink font-mono text-xs text-acid" aria-hidden="true">
      _
    </span>
  </div>
</div>
