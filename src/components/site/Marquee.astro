---
interface Props {
  items: string[]
}

const { items } = Astro.props
---

{items.length > 0 && (
  <div class="marquee border-y border-border py-4">
    <div class="marquee-track">
      <div class="flex shrink-0 items-center">
        {items.map((item, index) => (
          <span
            class="flex items-center gap-6 px-6 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground"
            data-index={index}
          >
            <span class="text-acid" aria-hidden="true">
              *
            </span>
            {item}
          </span>
        ))}
      </div>
      <div aria-hidden="true" class="flex shrink-0 items-center">
        {items.map((item, index) => (
          <span
            class="flex items-center gap-6 px-6 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground"
            data-index={index}
          >
            <span class="text-acid" aria-hidden="true">
              *
            </span>
            {item}
          </span>
        ))}
      </div>
    </div>
  </div>
)}
