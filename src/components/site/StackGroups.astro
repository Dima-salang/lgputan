---
import { skillGroups } from '#/data/skills'
import type { SkillGroup } from '#/data/skills'

interface Props {
  columns?: 2 | 3
  groups?: SkillGroup[]
}

const { columns = 2, groups = skillGroups } = Astro.props
const gridClass =
  columns === 2
    ? 'grid gap-x-10 gap-y-7 sm:grid-cols-2'
    : 'grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-3'
---

<div class={gridClass}>
  {groups.map((group) => (
    <section>
      <h3 class="label">{group.name}</h3>
      <p class="mt-2 text-sm leading-7 text-muted-foreground">
        {group.items.map((skill) => skill.name).join(', ')}
      </p>
    </section>
  ))}
</div>
